# Template for the local .env file. Copy it to .env and fill in real values; .env is
# gitignored and holds the actual secrets. This file is committed, so it must only ever
# contain placeholders, never real credentials. Every variable the project reads from
# the environment is listed here, grouped by the service that uses it.
#
# Use passwords without the characters @ / : # because they appear inside connection
# URLs below and would break parsing.

# --- PostgreSQL server ---
# Name of the database created on first start.
POSTGRES_DB=cairn
# Superuser the container is created with. Only the init script uses it; application
# code never connects as this user.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser

# --- Database roles ---
# One password per role, all different, so a leak of one does not grant the powers of
# another. The role names themselves are fixed in the init script.
# owner: creates and changes tables (migrations).
OWNER_PASSWORD=change-me-owner
# app: reads and writes rows (the API).
APP_PASSWORD=change-me-app
# agent: SELECT only (LLM agents).
AGENT_PASSWORD=change-me-agent

# --- Connection URLs used by the Python code ---
# These assume Python runs on the host machine, so the host is localhost. Code running
# inside a Compose container must use the service name instead.
# Each password and the port must match APP_PASSWORD / AGENT_PASSWORD / POSTGRES_PORT
# above; change them in both places.
APP_DATABASE_URL=postgresql+psycopg://cairn_app:change-me-app@localhost:5432/cairn
AGENT_DATABASE_URL=postgresql+psycopg://cairn_agent:change-me-agent@localhost:5432/cairn

# --- Experiment tracker ---
# Local MLflow server only; development never points at a lab server.
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Ports ---
# Host ports for the services. If you change one, update any URL above that uses it.
POSTGRES_PORT=5432
MLFLOW_PORT=5000
